# ==========================================
# Shop Bot MMO - Environment Configuration
# ==========================================

# Server
PORT=3000

# JWT Secret (auto-generated if not set)
# JWT_SECRET=your_secure_random_string_here

# Admin password (set on first run, auto-generated if not set)
# ADMIN_PASSWORD=your_admin_password

# Upstream Supplier API
API_BASE_URL=https://your-supplier-api.example.com
API_KEY=your_api_key_here
API_KEY_CAPTCHA=your_captcha_key_here

# PayOS Payment Gateway (VietQR)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_PAYMENT_ENABLED=true

# MSB Direct Payment (optional fallback)
# MSB_BANK_BIN=970422
# MSB_ACCOUNT_NUMBER=your_account_number
# MSB_ACCOUNT_NAME=your_account_name
# MSB_ACCESS_TOKEN=your_access_token

# Database (optional, defaults to ./data.db)
# DATABASE_PATH=./data.db

# Proxy (optional)
# TRUST_PROXY_HOPS=1
# ALLOWED_ORIGINS=https://yourdomain.com
